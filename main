DELIMITER $$

CREATE TRIGGER insere_estoque_com_quantidade_produto
AFTER INSERT ON produtos
FOR EACH ROW
BEGIN
  INSERT INTO estoques (quantidade_es, id_produto)
  VALUES (NEW.quantidade, NEW.id_produto);
END$$

DELIMITER ;


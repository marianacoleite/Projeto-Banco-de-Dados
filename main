--Procedures

DELIMITER $$

CREATE PROCEDURE cadastro_produto(
  nome VARCHAR(100),
  preco DECIMAL(10,2),
  quantidade INT,
  id_categoria INT
)
BEGIN
INSERT INTO produtos(nome,preco,quantidade_estoque,id_categoria)
VALUES (nome,preco,quantidade,id_categoria);

END $$
DELIMITER ;

........................................................................................................................


DELIMITER $$

CREATE PROCEDURE atualizar_preco_produto(
  id_produto INT,
  novo_preco DECIMAL(10,2)
)

END $$
DELIMITER ;


—------------------------------------------------------------------------------------------------------------------------
--Funções

DELIMITER $$

CREATE FUNCTION estoque_atual(id_produto INT)
RETURNS INT 

BEGIN
   
   DECLARE qtd INT;
   SELECT quantidade INTO qtd 
   FROM produtos 
   WHERE id_produto = id_produto;

   RETURN qtd;

END $$
DELIMITER ;

.......................................................................................................................

DELIMITER $$

CREATE FUNCTION cliente_ativo(id_cliente INT)
RETURNS BOOLEAN

BEGIN
  
  DECLARE situacao_cliente ENUM('Ativo', 'Inativo');
  SELECT sts INTO situacao_cliente 
  FROM cliente 
  WHERE id_cliente = id_cliente;

  RETURN situacao_cliente 'Ativo';

END $$
DELIMITER ;

.......................................................................................................................

DELIMITER$$

CREATE FUNCTION nome_funcionario(id_funcionario INT)
RETURNS VARCHAR(100)

BEGIN

  DECLARE nome VARCHAR(100);
  SELECT nome INTO nome 
  FROM funcionario 
  WHERE id_funcionario = id_funcionario;

  RETURN nome;
  
END$$
DELIMITER;

—------------------------------------------------------------------------------------------------------------------------
--Triggers 

ALTER TABLE clientes ADD COLUMN data_modificada DATETIME;

DELIMITER$$

CREATE TRIGGER update_cliente
BEFORE UPDATE ON clientes
FOR EACH ROW

BEGIN 
  SET NEW.data_modificada = NOW();

END$$
DELIMITER;

...........................................................................................................................

DELIMITER$$

CREATE TRIGGER bloquear_exclusao
BEFORE DELETE ON Produtos
FOR EACH ROW

BEGIN 
  DECLARE total INT;
  SELECT COUNT(*) INTO total 
  FROM itens_venda 
  WHERE id_produto = OLD.id_produto;

  IF total > 0 THEN;

    SIGNAL SQLSTATE '45000' 
    SET MESSAGE_TEXT = 'Produto vendido, não pode ser excluido';

  END IF;

END$$
DELIMITER;

—------------------------------------------------------------------------------------------------------------------------
--Views

CREATE VIEW produto_categorias AS 
SELECT c.nome ,COUNT(p.id) AS total
FROM produtos p 
JOIN categorias c ON p.id_categorias = c.id
GROUP BY c.nome;

...........................................................................................................................

CREATE VIEW estoque_baixo AS
SELECT * FROM produtos WHERE quantidade_estoque < 5;

...........................................................................................................................

CREATE VIEW detalhe_venda AS
SELECT v.id_venda, 
c.nome AS  cliente,
p.nome AS produtos,
itp.quantidade_item, 
p.preco
FROM vendas v
JOIN clientes c ON v.id_cliente = c.id_cliente
JOIN itens_pedido itp ON v.id_itens_pedido = itp.id_itens_pedido
JOIN produtos p ON itp.id_produto = p.id_produto;

...........................................................................................................................

CREATE VIEW total_vendido_produto AS
SELECT p.nome, SUM(ip.quantidade_item) AS total_vendido
FROM itens_pedido ip
JOIN produtos p ON ip.id_produto = p.id_produto
GROUP BY p.nome;


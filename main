SHOW DATABASES;

CREATE DATABASE baratao_do_bairro;

USE baratao_do_bairro;

CREATE TABLE categorias (
  id_categoria INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL
 );

CREATE TABLE produtos (
  id_produto INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  quantidade INT NOT NULL,
  preco DECIMAL(10,2) NOT NULL,
  id_categoria INT NOT NULL,
  FOREIGN KEY (id_categoria) REFERENCES categorias (id_categoria)
 );

CREATE TABLE funcionarios (
  id_funcionario INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  cargo VARCHAR(100) NOT NULL,
  salario DECIMAL (10,2) NOT NULL,
  telefone CHAR(14) NOT NULL,
  email VARCHAR(100) NOT NULL,
  endereco VARCHAR(100) NOT NULL,
  cpf CHAR(14) NOT NULL,
  sts ENUM (‘Ativo’,’Inativo’) NOT NULL
 );

CREATE TABLE fornecedores (
  id_fornecedores INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  telefone VARCHAR(15) NOT NULL,
  contato VARCHAR(100) NOT NULL,
  endereco VARCHAR(100) NOT NULL
 );

 CREATE TABLE clientes (
  id_cliente INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL,
  telefone CHAR(14) NOT NULL,
  email VARCHAR(100) NOT NULL,
  endereco VARCHAR(100) NOT NULL,
  cpf CHAR(14) NOT NULL,
  sts ENUM('Ativo', 'Inativo') NOT NULL
 );

CREATE TABLE pagamentos (
  id_pagamento INT PRIMARY KEY AUTO_INCREMENT,
  forma_pagar VARCHAR(45) NOT NULL
 );

CREATE TABLE estoques (
  id_estoque INT PRIMARY KEY AUTO_INCREMENT,
  quantidade_es INT NOT NULL,
  id_produto INT NOT NULL,
  FOREIGN KEY (id_produto) REFERENCES produtos (id_produto)
 );


CREATE TABLE itens_pedido (
  id_itens_pedido INT  PRIMARY KEY AUTO_INCREMENT,
  quantidade_item INT NOT NULL,
  valor_total DECIMAL(10,2) NOT NULL,
  dt_pedido DATE NOT NULL,
  sts ENUM('Aberto', 'Pago', 'Cancelado') NOT NULL,
  id_estoque INT NOT NULL,
  id_produto INT NOT NULL,
  FOREIGN KEY (id_estoque) REFERENCES estoques (id_estoque),
  FOREIGN KEY (id_produto ) REFERENCES produtos (id_produto )
  );

  CREATE TABLE vendas (
  id_venda INT  PRIMARY KEY AUTO_INCREMENT,
  dt_venda DATE NOT NULL,
  valor_total DECIMAL(10,2) NOT NULL,
  id_funcionario INT NOT NULL,
  id_cliente INT NOT NULL,
  id_pagamento INT NOT NULL,
  id_itens_pedido INT NOT NULL,
  FOREIGN KEY (id_funcionario) REFERENCES funcionarios (id_funcionario),
  FOREIGN KEY (id_cliente) REFERENCES clientes (id_cliente),
  FOREIGN KEY (id_pagamento) REFERENCES pagamentos (id_pagamento),
  FOREIGN KEY (id_itens_pedido) REFERENCES itens_pedido (id_itens_pedido)
 );


  CREATE TABLE produto_fornecedores (
  id_produto INT NOT NULL,
  id_categoria INT NOT NULL,
  id_fornecedores INT NOT NULL,
  FOREIGN KEY (id_produto) REFERENCES produtos (id_produto),
  FOREIGN KEY (id_categoria) REFERENCES categorias (id_categoria),
  FOREIGN KEY (id_fornecedores) REFERENCES fornecedores (id_fornecedores)
);

